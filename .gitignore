# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# OS cruft
.DS_Store
Thumbs.db

# Data / runs (large, external, not part of the code submission)
# See README.md "Configuring paths" -- point FISH_PIPELINE_DATA elsewhere
# instead of storing data under the repo. This still ignores it if you do.
data/
*.mp4
*.mov
*.avi

# ...except the bundled demo clip, which is small (~8 MB) and deliberately
# committed so the pipeline can be run end-to-end straight after cloning.
# See README.md "Try it on the bundled demo".
!demo/demo_clip.mp4

# Editor/IDE
.vscode/
.idea/
*.swp

# Training logs / large local artifacts (not the bundled inference weights)
model_training/*/runs/
model_training/*/wandb/
